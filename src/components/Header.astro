---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
// `sections` is a space-separated list of path prefixes that count as "current".
const links = [
    { label: "Discover", href: "/lookbook", sections: "/lookbook /lookbook-single /lookbook-double" },
    { label: "Archive", href: "/daily-diary", sections: "/daily-diary" },
    { label: "About", href: "/about-lovely-sunday", sections: "/about-lovely-sunday" },
    { label: "Contact", href: "/contact-lovely-sunday", sections: "/contact-lovely-sunday /contact" },
];

const isCurrent = (sections: string) =>
    sections
        .split(/\s+/)
        .some((section) => pathname === section || pathname.startsWith(`${section}/`));
---

<header class="site-head">
    <div class="site-head-container">
        <a class="site-head-logo" href="/" aria-label="Lovely Sunday home">
            <img src="/img/lovely-sunday-logo.svg" alt="Lovely Sunday" />
        </a>

        <nav class="site-head-nav" aria-label="Primary">
            {links.map((link) => (
                <a
                    href={link.href}
                    data-section={link.sections}
                    aria-current={isCurrent(link.sections) ? "page" : undefined}
                >
                    {link.label}
                </a>
            ))}
        </nav>
    </div>
</header>
