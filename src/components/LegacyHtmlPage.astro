---
import Layout from "../layouts/Layout.astro";
import "../styles/components/legacy-page.css";
import type { LegacyPage } from "../lib/legacy-pages";

export interface Props {
  page: LegacyPage;
}

const { page } = Astro.props;
const { view } = page;

const pageType = view.kind === "gallery" ? "article" : "collection";
const allParagraphs = view.description
  ? [view.description, ...view.paragraphs]
  : view.paragraphs;
const hasVisuals = Boolean(view.heroImage) || view.images.length > 0;
const socialImage = view.heroImage?.src || view.images[0]?.src;

const orientationFor = (image: (typeof view.images)[number]) => {
  if (!image.width || !image.height) return "unknown";
  if (Math.abs(image.width - image.height) <= 24) return "square";
  return image.height > image.width ? "portrait" : "landscape";
};

const galleryFrames = view.images.map((image) => ({
  image,
  orientation: orientationFor(image),
  span: "full" as "full" | "half",
}));

for (let index = 0; index < galleryFrames.length - 1; index += 1) {
  const current = galleryFrames[index];
  const next = galleryFrames[index + 1];

  if (
    current.orientation === "portrait" &&
    next.orientation === "portrait" &&
    current.span === "full" &&
    next.span === "full"
  ) {
    current.span = "half";
    next.span = "half";
    index += 1;
  }
}
---

<Layout
  title={view.title}
  description={view.description}
  seo={{ image: socialImage, pageType }}
>
  <article class={`legacy-page legacy-page--${view.kind}`}>
    <header class={`legacy-page-hero${view.heroImage ? " has-media" : ""}`}>
      <div class="legacy-page-copy">
        <p class="legacy-page-eyebrow">{view.eyebrow}</p>
        <h1>{view.title}</h1>

        {allParagraphs.slice(0, view.heroImage ? 2 : 3).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      {view.heroImage && (
        <figure class="legacy-page-hero-media">
          <img
            src={view.heroImage.src}
            alt={view.heroImage.alt}
            width={view.heroImage.width}
            height={view.heroImage.height}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </figure>
      )}
    </header>

    {view.links.length > 0 && (
      <section class="legacy-page-links" aria-label="Explore more">
        <ul>
          {view.links.map((link) => (
            <li>
              <a href={link.href} rel={link.external ? "noreferrer" : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {view.images.length > 0 && (
      <section class={`legacy-page-gallery${hasVisuals ? "" : " no-hero"}`} aria-label="Gallery">
        {galleryFrames.map(({ image, orientation, span }, index) => (
          <figure
            class={`legacy-page-frame is-${span}-span orientation-${orientation}`}
            data-orientation={orientation}
          >
            <img
              src={image.src}
              alt={image.alt}
              width={image.width}
              height={image.height}
              data-image-dimensions={
                image.width && image.height ? `${image.width}x${image.height}` : undefined
              }
              loading={index < 4 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index === 0 && !view.heroImage ? "high" : undefined}
            />
          </figure>
        ))}
      </section>
    )}

    {allParagraphs.slice(view.heroImage ? 2 : 3).length > 0 && (
      <section class="legacy-page-body">
        {allParagraphs.slice(view.heroImage ? 2 : 3).map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </section>
    )}
  </article>

  <slot />
</Layout>
