---
import type { InstagramPost } from "../lib/instagram";

interface Props {
  title?: string;
  subtitle?: string;
  posts?: InstagramPost[];
}

const {
  title = "From @_lovelysunday on Instagram",
  subtitle = "Live pulls from the latest looks and travel moments.",
  posts = [],
} = Astro.props;
---

{posts.length > 0 && (
  <section class="instagram-grid" aria-label="Instagram feed">
    <header class="instagram-grid__header" data-reveal>
      <h2 class="section-title">{title}</h2>
      <p>{subtitle}</p>
    </header>

    <div class="instagram-grid__items">
      {posts.map((post) => (
        <a href={post.permalink} target="_blank" rel="noopener noreferrer" class="instagram-grid__card" data-reveal>
          <img src={post.imageUrl} alt={post.caption || "Instagram post from @_lovelysunday"} loading="lazy" />
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .instagram-grid {
    width: min(100%, var(--container));
    margin: var(--section-gap) auto 0;
  }

  .instagram-grid__header h2 {
    margin: 0;
  }

  .instagram-grid__header p {
    margin: var(--space-2) 0 var(--space-5);
    max-width: 50ch;
    font-size: var(--text-md);
    opacity: 0.65;
  }

  .instagram-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .instagram-grid__card {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 1 / 1;
    background: var(--color-bg-subtle);
  }

  .instagram-grid__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .instagram-grid__card:hover img,
  .instagram-grid__card:focus-visible img {
    transform: scale(var(--hover-scale));
  }

  @media (max-width: 640px) {
    .instagram-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .instagram-grid__card:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 1.6 / 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-grid__card img {
      transition: none;
    }
  }
</style>
