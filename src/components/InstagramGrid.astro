---
import type { InstagramPost } from "../lib/instagram";

interface Props {
  title?: string;
  subtitle?: string;
  posts?: InstagramPost[];
}

const {
  title = "From @_lovelysunday on Instagram",
  subtitle = "Live pulls from the latest looks and travel moments.",
  posts = [],
} = Astro.props;
---

{posts.length > 0 && (
  <section class="instagram-grid" aria-label="Instagram feed">
    <header class="instagram-grid__header">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </header>

    <div class="instagram-grid__items">
      {posts.map((post) => (
        <a href={post.permalink} target="_blank" rel="noopener noreferrer" class="instagram-grid__card">
          <img src={post.imageUrl} alt={post.caption || "Instagram post from @_lovelysunday"} loading="lazy" />
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .instagram-grid {
    width: min(100%, 1180px);
    margin: clamp(4rem, 8vw, 7rem) auto 2rem;
  }

  .instagram-grid__header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 400;
    line-height: 1;
  }

  .instagram-grid__header p {
    margin: 0.5rem 0 1.25rem;
    max-width: 50ch;
    opacity: 0.62;
  }

  .instagram-grid__items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.65rem, 1.2vw, 1rem);
  }

  .instagram-grid__card {
    display: block;
    overflow: hidden;
    border-radius: 0.8rem;
    aspect-ratio: 1 / 1;
    background: color-mix(in srgb, var(--color-ink) 8%, white);
  }

  .instagram-grid__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .instagram-grid__card:hover img,
  .instagram-grid__card:focus-visible img {
    transform: scale(1.03);
  }

  @media (max-width: 640px) {
    .instagram-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .instagram-grid__card:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 1.6 / 1;
    }
  }
</style>
