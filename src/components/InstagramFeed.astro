---
import { getInstagramMedia, getRelevantInstagramMedia } from "../lib/instagram";

interface Props {
  title?: string;
  description?: string;
  slug?: string;
  heading?: string;
  limit?: number;
}

const {
  title,
  description,
  slug,
  heading = "From Instagram",
  limit = 6,
} = Astro.props;

const media = await getInstagramMedia(24);
const relevantMedia = getRelevantInstagramMedia(media, { title, description, slug }, limit);
---

{relevantMedia.length > 0 && (
  <section class="instagram-feed" aria-label="Latest Instagram photos from @lovelysunday">
    <div class="instagram-feed-header" data-reveal>
      <h2 class="section-title">{heading}</h2>
      <a class="label" href="https://www.instagram.com/_lovelysunday/" target="_blank" rel="noreferrer noopener">
        @_lovelysunday
      </a>
    </div>

    <div class="instagram-feed__items">
      {relevantMedia.map((item) => (
        <a class="instagram-card" href={item.permalink} target="_blank" rel="noreferrer noopener" data-reveal>
          <img src={item.thumbnailUrl} alt={item.caption || "Instagram post by @lovelysunday"} loading="lazy" />
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .instagram-feed {
    width: min(100%, var(--container-prose));
    margin: var(--section-gap) auto 0;
  }

  .instagram-feed-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .instagram-feed-header h2 {
    margin: 0;
  }

  .instagram-feed-header a {
    color: inherit;
    opacity: 0.7;
  }

  .instagram-feed__items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .instagram-card {
    aspect-ratio: 1;
    overflow: hidden;
    display: block;
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .instagram-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .instagram-card:hover img,
  .instagram-card:focus-visible img {
    transform: scale(var(--hover-scale));
  }

  @media (min-width: 720px) {
    .instagram-feed__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-card img {
      transition: none;
    }
  }
</style>
