---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomePostList from "../components/home/HomePostList.astro";
import InstagramGrid from "../components/InstagramGrid.astro";
import { getHeroPhotos, getHomePosts } from "../lib/home";
import { getInstagramPosts } from "../lib/instagram";

const INSTAGRAM_USERNAME = "_lovelysunday";

const title = "Romantic style, lived beautifully.";
const description =
  "An edit of expressive looks, faraway places, and the small details that make everyday life feel lovely.";

const heroPhotos = getHeroPhotos();
const posts = getHomePosts(12);
const instagramPosts = await getInstagramPosts(INSTAGRAM_USERNAME, 9);
---

<Layout
  title={title}
  description={description}
  seo={{ image: heroPhotos[0]?.src, pageType: "collection" }}
>
  <div class="home">
    <HomeHero photos={heroPhotos} title={title} lead={description} />
    <HomePostList posts={posts} />
  </div>

  <InstagramGrid
    title="The latest edit"
    subtitle="Recent looks and travel moments from @_lovelysunday."
    posts={instagramPosts}
  />
</Layout>
