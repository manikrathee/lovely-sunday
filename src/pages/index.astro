---
import LegacyHtmlPage from "../components/LegacyHtmlPage.astro";
import InstagramGrid from "../components/InstagramGrid.astro";
import { getLegacyPageBySourcePathname } from "../lib/legacy-pages";
import { getInstagramPosts } from "../lib/instagram";

const INSTAGRAM_USERNAME = "_lovelysunday";

const homePage = getLegacyPageBySourcePathname("/");
if (!homePage) {
  throw new Error("Missing legacy homepage source for '/'");
}

const cleanedHomePage = {
  ...homePage,
  view: {
    ...homePage.view,
    eyebrow: "A personal style journal",
    title: "Romantic style, lived beautifully.",
    description:
      "An edit of expressive looks, faraway places, and the small details that make everyday life feel lovely.",
    heroImage: homePage.view.images[3],
    images: homePage.view.images.filter((_, index) => index !== 3),
    links: [
      { external: false, href: "/lookbook", label: "Explore the lookbook" },
      { external: false, href: "/daily-diary", label: "Read the archive" },
    ],
    paragraphs: [],
  },
};

const instagramPosts = await getInstagramPosts(INSTAGRAM_USERNAME, 9);
---

<LegacyHtmlPage page={cleanedHomePage}>
  <InstagramGrid
    title="The latest edit"
    subtitle="Recent looks and travel moments from @_lovelysunday."
    posts={instagramPosts}
  />
</LegacyHtmlPage>
