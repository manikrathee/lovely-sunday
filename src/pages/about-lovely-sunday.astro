---
import Layout from "../layouts/Layout.astro";
import aboutPage from "../../capture/page_json/about-lovely-sunday-d298690e81.json";

type CaptureImage = {
  src: string;
  alt?: string;
};

const images = (aboutPage.images as CaptureImage[]).filter((image) => image.src);
const [heroImage, logoImage, profileImage, ...hiddenImages] = images;
---

<Layout
  title="About LovelySunday"
  description="Meet Aileen and discover the style journey behind Lovely Sunday."
  breadcrumbs={false}
  seo={{ pageType: "profile", image: heroImage.src }}
>
  <article class="about-page">
    <img class="hero" src={heroImage.src} alt={heroImage.alt ?? ""} data-reveal />

    <div class="about-inner">
      <div class="brand" data-reveal>
        <img src={logoImage.src} alt={logoImage.alt ?? "LovelySunday"} />
      </div>

      <div class="content-grid">
        <section data-reveal>
          <h1>The girl behind Lovely Sunday</h1>
          <h2 class="section-title">Welcome to LovelySunday</h2>

          <p>Hi, I'm Aileen.</p>
          <p>
            My love for fashion started when I was in fourth grade with two significant moments: the first
            time I saw Cher’s closet in Clueless (obviously!) and when my Grandpa handed me the New York Times
            Fashion Magazine and I fell in love with the beautiful art and clothing I discovered inside.
          </p>
          <p>
            I always wanted to work in fashion, but I wasn't sure of exactly what I wanted to do. I decided to
            start a fashion blog since I love to play dress up, have way too many shoes, and I could help people
            understand why fashion is so important in expressing ourselves.
          </p>
          <p>
            Since my husband and I are photographers- the quality, the viewpoint, and styling behind each photo
            is so important to me. I could not ask for someone better at understanding my vision while enjoying
            what we love. I hope you enjoy my passion project, learn to shop smarter, and that I can inspire you
            in any way.
          </p>
        </section>

        <aside>
          <section class="panel" data-reveal>
            <h3 class="label">Meet Aileen</h3>
            <img class="profile" src={profileImage.src} alt={profileImage.alt ?? ""} />
          </section>

          <section class="panel" data-reveal>
            <h3 class="label">Subscribe to LovelySunday</h3>
            <p>Get updates on new looks and posts!</p>
            <input type="email" placeholder="Email Address" aria-label="Email Address" />
            <button type="button">Sign Up</button>
          </section>

          <section class="panel" data-reveal>
            <h3 class="label">Contact Me</h3>
            <p>Explore looks, style and fun travel recommendations</p>
          </section>
        </aside>
      </div>
    </div>

    <div class="hidden-media" aria-hidden="true">
      {hiddenImages.slice(0, -1).map((image) => <img src={image.src} alt={image.alt ?? ""} />)}
    </div>
  </article>
</Layout>

<style>
  .about-page {
    width: min(100%, var(--container));
    margin: 0 auto;
  }

  .hero {
    display: block;
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-bg-subtle);
  }

  .about-inner {
    padding: var(--block-gap) 0 0;
  }

  .brand {
    margin: 0 0 var(--block-gap);
    text-align: center;
  }

  .brand img {
    width: min(100%, 420px);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--block-gap);
    align-items: start;
  }

  .about-page section > h1 {
    margin-bottom: var(--space-4);
  }

  .about-page section > h2 {
    margin-bottom: var(--space-4);
  }

  .about-page p {
    margin: 0 0 var(--space-4);
    max-width: 62ch;
  }

  .panel {
    padding: var(--space-5);
    margin-bottom: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .panel h3 {
    margin: 0 0 var(--space-3);
  }

  .panel p:last-child {
    margin-bottom: 0;
  }

  .profile {
    display: block;
    width: 100%;
    margin-top: var(--space-3);
    border-radius: var(--radius-md);
  }

  input,
  button {
    width: 100%;
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  input {
    padding: 0 var(--space-3);
    height: var(--height);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: inherit;
  }

  .hidden-media {
    display: none;
  }

  @media (max-width: 800px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
